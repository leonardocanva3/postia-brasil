generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CalendarItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

enum GeneratedPostStatus {
  GENERATED
  ARCHIVED
}

enum GeneratedCaptionStatus {
  GENERATED
  ARCHIVED
}

enum EditorialCalendarStatus {
  IDEA
  PLANNED
  IN_PRODUCTION
  READY
  PUBLISHED
  CANCELED
}

enum ScheduledPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELED
}

enum WhatsAppShareStatus {
  READY
  SENT
  FAILED
}

enum CompanyImageType {
  FACHADA
  DONO
  EQUIPE
  PRODUTO
  SERVICO
  AMBIENTE
  ANTES_DEPOIS
  EQUIPAMENTO
  VEICULO
  OUTRO
}

enum ArtFormat {
  FEED_RETRATO
  FEED_QUADRADO
  REELS_STORIES
}

enum ArtStyle {
  PREMIUM_LUXO
  CLEAN_MODERNO
  CORPORATIVO
  MINIMALISTA
  IMPACTO_COMERCIAL
  PROMOCIONAL
  INSTITUCIONAL
  EDUCATIVO
  MEDICO_PREMIUM
  AUTOMOTIVO_PERFORMANCE
  LOGISTICA_FORTE
  ELEGANCIA_FEMININA
  ALTO_PADRAO
}

enum DesignerLevel {
  JUNIOR
  PLENO
  SENIOR
  PREMIUM
}

enum CampaignStatus {
  DRAFT
  PLANNED
  GENERATED
  SCHEDULED
  PUBLISHED
  CANCELED
}

enum GeneratedArtStatus {
  DRAFT
  GENERATED
  FAILED
  ARCHIVED
}

model Company {
  id                  String                  @id @default(uuid())
  name                String
  slug                String                  @unique
  businessSegmentId   String?
  businessSpecialtyId String?
  website             String?
  instagram           String?
  description         String?
  services            String?
  differentiators     String?
  targetAudience      String?
  recommendedTone     String?
  defaultCta          String?
  brandColors         String[]
  logoUrl             String?
  postIdeas           String[]
  designNotes         String?
  collectedInfo       String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  members             CompanyMember[]
  posts               Post[]
  captions            Caption[]
  calendarItems       CalendarItem[]
  subscriptions       Subscription[]
  payments            Payment[]
  generatedPosts      GeneratedPost[]
  generatedCaptions   GeneratedCaption[]
  editorialItems      EditorialCalendarItem[]
  scheduledPosts      ScheduledPost[]
  whatsappContacts    WhatsAppContact[]
  whatsappShareLogs   WhatsAppShareLog[]
  campaigns           Campaign[]
  campaignItems       CampaignItem[]
  images              CompanyImage[]
  generatedArts       GeneratedArt[]
  generatedArtworks   GeneratedArtwork[]
  businessSegment     BusinessSegment?        @relation(fields: [businessSegmentId], references: [id], onDelete: SetNull)
  businessSpecialty   BusinessSpecialty?      @relation(fields: [businessSpecialtyId], references: [id], onDelete: SetNull)

  @@index([businessSegmentId])
  @@index([businessSpecialtyId])
  @@map("companies")
}

model User {
  id                String                  @id @default(uuid())
  name              String?
  email             String                  @unique
  passwordHash      String
  isPlatformAdmin   Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  companies         CompanyMember[]
  posts             Post[]
  captions          Caption[]
  calendarItems     CalendarItem[]
  generatedPosts    GeneratedPost[]
  generatedCaptions GeneratedCaption[]
  editorialItems    EditorialCalendarItem[]
  scheduledPosts    ScheduledPost[]
  whatsappShareLogs WhatsAppShareLog[]
  campaigns         Campaign[]
  campaignItems     CampaignItem[]
  generatedArts     GeneratedArt[]
  generatedArtworks GeneratedArtwork[]
  adminLogs         AdminLog[]

  @@map("users")
}

model CompanyMember {
  id        String            @id @default(uuid())
  role      CompanyMemberRole @default(EDITOR)
  companyId String
  userId    String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model Post {
  id          String     @id @default(uuid())
  title       String
  content     String?
  status      PostStatus @default(DRAFT)
  companyId   String
  authorId    String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  captions      Caption[]
  calendarItems CalendarItem[]

  @@index([companyId])
  @@index([authorId])
  @@map("posts")
}

model Caption {
  id        String   @id @default(uuid())
  text      String
  companyId String
  postId    String?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  post    Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([postId])
  @@index([authorId])
  @@map("captions")
}

model CalendarItem {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      CalendarItemStatus @default(PLANNED)
  companyId   String
  postId      String?
  authorId    String?
  scheduledAt DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  post    Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, scheduledAt])
  @@index([postId])
  @@index([authorId])
  @@map("calendar_items")
}

model Plan {
  id                   String         @id @default(uuid())
  name                 String         @unique
  description          String
  monthlyPrice         Decimal        @db.Decimal(10, 2)
  monthlyPostLimit     Int?
  monthlyCaptionLimit  Int?
  monthlyCalendarLimit Int?
  monthlyArtLimit      Int?
  monthlyAnalysisLimit Int?
  monthlyCampaignLimit Int?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([companyId, status])
  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  companyId         String
  subscriptionId    String
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  paymentMethod     String
  externalReference String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([subscriptionId])
  @@map("payments")
}

model GeneratedPost {
  id               String              @id @default(uuid())
  companyId        String
  userId           String
  businessType     String
  objective        String
  tone             String
  platform         String
  prompt           String
  title            String
  content          String
  hashtags         String[]
  cta              String
  formatSuggestion String
  status           GeneratedPostStatus @default(GENERATED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts    ScheduledPost[]
  whatsappShareLogs WhatsAppShareLog[]
  generatedArts     GeneratedArt[]
  campaignItems     CampaignItem[]

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("generated_posts")
}

model GeneratedCaption {
  id        String                 @id @default(uuid())
  companyId String
  userId    String
  platform  String
  subject   String
  tone      String
  caption   String
  emojis    String[]
  hashtags  String[]
  cta       String
  status    GeneratedCaptionStatus @default(GENERATED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts    ScheduledPost[]
  whatsappShareLogs WhatsAppShareLog[]
  generatedArts     GeneratedArt[]
  campaignItems     CampaignItem[]

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("generated_captions")
}

model EditorialCalendarItem {
  id            String                  @id @default(uuid())
  companyId     String
  userId        String
  title         String
  description   String
  platform      String
  contentType   String
  objective     String
  suggestedDate DateTime
  status        EditorialCalendarStatus @default(IDEA)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]

  @@index([companyId, suggestedDate])
  @@index([userId])
  @@map("editorial_calendar_items")
}

model ScheduledPost {
  id                      String              @id @default(uuid())
  companyId               String
  userId                  String
  generatedPostId         String?
  generatedCaptionId      String?
  editorialCalendarItemId String?
  title                   String
  content                 String
  platform                String
  scheduledFor            DateTime
  status                  ScheduledPostStatus @default(SCHEDULED)
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPost         GeneratedPost?         @relation(fields: [generatedPostId], references: [id], onDelete: SetNull)
  generatedCaption      GeneratedCaption?      @relation(fields: [generatedCaptionId], references: [id], onDelete: SetNull)
  editorialCalendarItem EditorialCalendarItem? @relation(fields: [editorialCalendarItemId], references: [id], onDelete: SetNull)
  whatsappShareLogs     WhatsAppShareLog[]
  generatedArts         GeneratedArt[]
  campaignItems         CampaignItem[]

  @@index([companyId, scheduledFor])
  @@index([userId])
  @@index([generatedPostId])
  @@index([generatedCaptionId])
  @@index([editorialCalendarItemId])
  @@map("scheduled_posts")
}

model WhatsAppContact {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  phone       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("whatsapp_contacts")
}

model WhatsAppShareLog {
  id                 String              @id @default(uuid())
  companyId          String
  userId             String
  scheduledPostId    String?
  generatedPostId    String?
  generatedCaptionId String?
  phone              String
  message            String
  status             WhatsAppShareStatus @default(READY)
  createdAt          DateTime            @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPost    ScheduledPost?    @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)
  generatedPost    GeneratedPost?    @relation(fields: [generatedPostId], references: [id], onDelete: SetNull)
  generatedCaption GeneratedCaption? @relation(fields: [generatedCaptionId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([scheduledPostId])
  @@index([generatedPostId])
  @@index([generatedCaptionId])
  @@map("whatsapp_share_logs")
}

model CompanyImage {
  id          String           @id @default(uuid())
  companyId   String
  title       String
  type        CompanyImageType
  description String?
  tags        String[]
  imageUrl    String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedArts GeneratedArt[]

  @@index([companyId, isActive])
  @@map("company_images")
}

model GeneratedArt {
  id                 String             @id @default(uuid())
  companyId          String
  userId             String
  generatedPostId    String?
  generatedCaptionId String?
  scheduledPostId    String?
  companyImageId     String?
  artTemplateId      String?
  subject            String
  objective          String
  platform           String
  format             ArtFormat
  style              ArtStyle?
  designerLevel      DesignerLevel      @default(SENIOR)
  width              Int
  height             Int
  aspectRatio        String
  title              String
  useLogo            Boolean            @default(true)
  useBrandColors     Boolean            @default(true)
  outputMimeType     String             @default("image/png")
  quality            String             @default("high")
  prompt             String?
  imageUrl           String?
  templateMetadata   Json?
  status             GeneratedArtStatus @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPost    GeneratedPost?    @relation(fields: [generatedPostId], references: [id], onDelete: SetNull)
  generatedCaption GeneratedCaption? @relation(fields: [generatedCaptionId], references: [id], onDelete: SetNull)
  scheduledPost    ScheduledPost?    @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)
  companyImage     CompanyImage?     @relation(fields: [companyImageId], references: [id], onDelete: SetNull)
  artTemplate      ArtTemplate?      @relation(fields: [artTemplateId], references: [id], onDelete: SetNull)
  campaignItems    CampaignItem[]

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([generatedPostId])
  @@index([generatedCaptionId])
  @@index([scheduledPostId])
  @@index([companyImageId])
  @@index([artTemplateId])
  @@map("generated_arts")
}

model GeneratedArtwork {
  id           String             @id @default(uuid())
  companyId    String
  userId       String
  title        String
  prompt       String
  format       ArtFormat
  imageUrl     String
  thumbnailUrl String
  status       GeneratedArtStatus @default(GENERATED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("generated_artworks")
}

model Campaign {
  id        String         @id @default(uuid())
  companyId String
  userId    String
  title     String
  objective String
  mainTopic String
  platform  String
  startDate DateTime
  endDate   DateTime
  status    CampaignStatus @default(GENERATED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CampaignItem[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([userId])
  @@map("campaigns")
}

model CampaignItem {
  id                 String            @id @default(uuid())
  campaignId         String
  companyId          String
  userId             String
  title              String
  contentType        String
  postIdea           String
  caption            String
  cta                String
  hashtags           String[]
  suggestedDate      DateTime
  artFormat          ArtFormat
  artStyle           ArtStyle?
  designerLevel      DesignerLevel     @default(SENIOR)
  generatedPostId    String?
  generatedCaptionId String?
  generatedArtId     String?
  scheduledPostId    String?
  status             CampaignStatus    @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPost      GeneratedPost?    @relation(fields: [generatedPostId], references: [id], onDelete: SetNull)
  generatedCaption   GeneratedCaption? @relation(fields: [generatedCaptionId], references: [id], onDelete: SetNull)
  generatedArt       GeneratedArt?     @relation(fields: [generatedArtId], references: [id], onDelete: SetNull)
  scheduledPost      ScheduledPost?    @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([companyId, suggestedDate])
  @@index([userId])
  @@index([generatedPostId])
  @@index([generatedCaptionId])
  @@index([generatedArtId])
  @@index([scheduledPostId])
  @@map("campaign_items")
}

model AISettings {
  id          String   @id @default(uuid())
  provider    String   @default("OPENAI")
  textModel   String   @default("gpt-4.1-mini")
  imageModel  String   @default("gpt-image-1")
  temperature Float    @default(0.7)
  maxTokens   Int      @default(1200)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("ai_settings")
}

model BusinessSegment {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  specialties BusinessSpecialty[]
  companies   Company[]
  templates   ArtTemplate[]

  @@index([isActive])
  @@map("business_segments")
}

model BusinessSpecialty {
  id               String          @id @default(uuid())
  segmentId        String
  name             String
  slug             String          @unique
  description      String
  keywords         String[]
  recommendedTone  String
  commonServices   String[]
  contentIdeas     String[]
  visualStyle      String
  colorSuggestions String[]
  iconSuggestions  String[]
  complianceNotes  String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  segment          BusinessSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  companies        Company[]
  templates        ArtTemplate[]

  @@index([segmentId, isActive])
  @@map("business_specialties")
}

model ArtTemplate {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  segmentId     String?
  specialtyId   String?
  format        ArtFormat
  description   String
  visualStyle   String
  layoutHints   String
  previewUrl    String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  segment       BusinessSegment?   @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  specialty     BusinessSpecialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  generatedArts GeneratedArt[]

  @@index([segmentId, isActive])
  @@index([specialtyId, isActive])
  @@index([format, isActive])
  @@map("art_templates")
}

model AdminLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("admin_logs")
}
